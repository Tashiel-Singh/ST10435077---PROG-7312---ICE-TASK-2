<Window x:Class="GameScriptManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GameScriptManager"
        mc:Ignorable="d"
        Title="Game Script Manager — Cybersphere Story Engine (ST10435077)" 
        Height="800" Width="1160"
        MinHeight="650" MinWidth="950"
        WindowStartupLocation="CenterScreen"
        Background="#0D1117"
        Foreground="#E6EDF3"
        FontFamily="Segoe UI"
        KeyDown="OnWindowKeyDown">

    <Window.Resources>
        <!-- Color Palette -->
        <SolidColorBrush x:Key="BgPrimary" Color="#0D1117"/>
        <SolidColorBrush x:Key="BgSecondary" Color="#161B22"/>
        <SolidColorBrush x:Key="BgCard" Color="#21262D"/>
        <SolidColorBrush x:Key="BgHover" Color="#30363D"/>
        <SolidColorBrush x:Key="BorderColor" Color="#30363D"/>
        <SolidColorBrush x:Key="AccentCyan" Color="#58A6FF"/>
        <SolidColorBrush x:Key="AccentCyanGlow" Color="#00D2FF"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#3FB950"/>
        <SolidColorBrush x:Key="AccentPurple" Color="#A371F7"/>
        <SolidColorBrush x:Key="AccentOrange" Color="#F0883E"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#F0F6FC"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#8B949E"/>

        <!-- Custom ScrollBar Style -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="8"/>
        </Style>

        <!-- Standard Button Style -->
        <Style x:Key="CyberButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BgSecondary}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#30363D"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource AccentCyan}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#1C2128"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Accent Primary Button Style -->
        <Style x:Key="AccentPrimaryButton" TargetType="Button" BasedOn="{StaticResource CyberButton}">
            <Setter Property="Background" Value="#1F6FEB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#388BFD"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#388BFD"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource AccentCyanGlow}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#1158C7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Accent Success Button Style -->
        <Style x:Key="AccentSuccessButton" TargetType="Button" BasedOn="{StaticResource CyberButton}">
            <Setter Property="Background" Value="#238636"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#2EA043"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#2EA043"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#196C2E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- View Mode Radio Button (Tab Style) -->
        <Style x:Key="TabRadioButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="TabBorder" 
                                Background="Transparent" 
                                BorderBrush="Transparent" 
                                BorderThickness="0,0,0,3" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#1C2128"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource AccentCyan}"/>
                                <Setter TargetName="TabBorder" Property="Background" Value="#161B22"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentCyan}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Navigation Arrow Button -->
        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource CyberButton}">
            <Setter Property="Padding" Value="18,12"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- 0: Header -->
            <RowDefinition Height="Auto"/>
            <!-- 1: Control Bar -->
            <RowDefinition Height="Auto"/>
            <!-- 2: View Mode Tabs -->
            <RowDefinition Height="Auto"/>
            <!-- 3: Main Workspace (Display Areas) -->
            <RowDefinition Height="*"/>
            <!-- 4: Bottom Node Visualizer Chain -->
            <RowDefinition Height="Auto"/>
            <!-- 5: Status Bar -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ========================================== -->
        <!-- ROW 0: HEADER -->
        <!-- ========================================== -->
        <Border Grid.Row="0" Background="#161B22" BorderBrush="#30363D" BorderThickness="0,0,0,1" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚡ CYBERSPHERE" FontSize="20" FontWeight="Black" Foreground="{StaticResource AccentCyanGlow}"/>
                        <TextBlock Text=" GAME SCRIPT MANAGER" FontSize="20" FontWeight="Black" Foreground="{StaticResource TextPrimary}"/>
                        <Border Background="#238636" CornerRadius="4" Margin="12,2,0,2" Padding="8,2">
                            <TextBlock Text="PROG7312 ICE 2" FontSize="11" FontWeight="Bold" Foreground="White"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Doubly Linked List Story Disordering, In-Place Sorting &amp; Interactive Dual Display Engine" 
                               FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,3,0,0"/>
                </StackPanel>

                <!-- Student Info Badge -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Border Background="#21262D" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="12,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="👤 Student: " FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                            <TextBlock Text="Tashiel Singh (ST10435077)" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" FontSize="12"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ========================================== -->
        <!-- ROW 1: CONTROLS & SORTING TOOLBAR -->
        <!-- ========================================== -->
        <Border Grid.Row="1" Background="#0D1117" BorderBrush="#30363D" BorderThickness="0,0,0,1" Padding="20,12">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Data Source Group -->
                <Button Content="📥 Load Sample Script (Unordered)" Style="{StaticResource CyberButton}" 
                        Click="OnLoadSampleClick" Margin="0,0,10,6" ToolTip="Load the original 12 unordered script paragraphs"/>

                <!-- Sorting Algorithm Selection -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,6">
                    <TextBlock Text="Algorithm:" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" 
                               Margin="0,0,8,0" FontWeight="SemiBold" FontSize="13"/>
                    <ComboBox x:Name="CmbAlgorithm" Width="170" Height="34" VerticalContentAlignment="Center" 
                              Background="#161B22" Foreground="#F0F6FC" BorderBrush="#30363D" FontSize="13">
                        <ComboBoxItem Content="Insertion Sort (Optimal)" IsSelected="True" Tag="InsertionSort"/>
                        <ComboBoxItem Content="Bubble Sort (Swaps)" Tag="BubbleSort"/>
                        <ComboBoxItem Content="Merge Sort (O(N log N))" Tag="MergeSort"/>
                    </ComboBox>
                </StackPanel>

                <!-- Sort Button -->
                <Button x:Name="BtnSort" Content="🔄 Sort Linked List" Style="{StaticResource AccentSuccessButton}" 
                        Click="OnSortClick" Margin="0,0,10,6" ToolTip="Sort the linked list nodes by Story Number"/>

                <!-- Scramble / Shuffle Button -->
                <Button Content="🔀 Scramble / Shuffle" Style="{StaticResource CyberButton}" 
                        Click="OnShuffleClick" Margin="0,0,10,6" ToolTip="Randomize the nodes to test sorting again"/>

                <!-- Add Custom Scene Button -->
                <Button Content="➕ Add Story Scene" Style="{StaticResource CyberButton}" 
                        Click="OnAddSceneClick" Margin="0,0,10,6" ToolTip="Add a custom node to the linked list"/>

                <!-- Clear / Reset Button -->
                <Button Content="🗑 Clear All" Style="{StaticResource CyberButton}" 
                        Click="OnClearClick" Margin="0,0,10,6" ToolTip="Empty the linked list"/>
            </WrapPanel>
        </Border>

        <!-- ========================================== -->
        <!-- ROW 2: VIEW MODE SELECTOR (TABS) -->
        <!-- ========================================== -->
        <Border Grid.Row="2" Background="#161B22" BorderBrush="#30363D" BorderThickness="0,0,0,1" Padding="20,0">
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="RbFullView" Content="📖 Full Script View (Display Area 1)" 
                             Style="{StaticResource TabRadioButton}" Checked="OnViewModeChanged"/>
                <RadioButton x:Name="RbLineView" Content="🎮 One-Line Navigation Mode (Display Area 2)" 
                             Style="{StaticResource TabRadioButton}" Checked="OnViewModeChanged"/>
                <RadioButton x:Name="RbSplitView" Content="⚡ Side-by-Side Dual View (Full &amp; One-Line)" 
                             IsChecked="True" Style="{StaticResource TabRadioButton}" Checked="OnViewModeChanged"/>
            </StackPanel>
        </Border>

        <!-- ========================================== -->
        <!-- ROW 3: MAIN DISPLAY AREAS -->
        <!-- ========================================== -->
        <Grid Grid.Row="3" Margin="20,16">
            <Grid.ColumnDefinitions>
                <!-- Display Area 1 Column -->
                <ColumnDefinition x:Name="ColDisplayArea1" Width="1.1*"/>
                <!-- Splitter -->
                <ColumnDefinition x:Name="ColSplitter" Width="12"/>
                <!-- Display Area 2 Column -->
                <ColumnDefinition x:Name="ColDisplayArea2" Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- ======================================================== -->
            <!-- DISPLAY AREA 1: FULL SCRIPT (ALL PARAGRAPHS COMBINED)     -->
            <!-- ======================================================== -->
            <Border x:Name="CardDisplayArea1" Grid.Column="0" Background="#161B22" BorderBrush="#30363D" 
                    BorderThickness="1" CornerRadius="8" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Title & Format Toggle -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📜 DISPLAY AREA 1: FULL SCRIPT" FontSize="15" FontWeight="Bold" Foreground="{StaticResource AccentCyan}"/>
                            <Border x:Name="BadgeSortState" Background="#388BFD" CornerRadius="4" Margin="10,0,0,0" Padding="6,2">
                                <TextBlock x:Name="TxtSortStateBadge" Text="SORTED" FontSize="11" FontWeight="Bold" Foreground="White"/>
                            </Border>
                        </StackPanel>

                        <!-- Actions -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="📋 Copy Script" Style="{StaticResource CyberButton}" Padding="8,4" FontSize="12" 
                                    Click="OnCopyScriptClick" Margin="0,0,6,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- Search / Filter Box -->
                    <Border Grid.Row="1" Background="#21262D" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Margin="0,0,0,12" Padding="8,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="🔍" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource TextSecondary}"/>
                            <TextBox x:Name="TxtSearchScript" Grid.Column="1" Background="Transparent" Foreground="{StaticResource TextPrimary}" 
                                     BorderThickness="0" FontSize="13" TextChanged="OnScriptSearchChanged" 
                                     VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtSearchPlaceholder" Grid.Column="1" Text="Search story by keyword (e.g. 'Alex', 'Malware')..." 
                                       Foreground="#6E7681" IsHitTestVisible="False" VerticalAlignment="Center" FontSize="13"/>
                            <Button x:Name="BtnClearSearch" Grid.Column="2" Content="✕" Style="{StaticResource CyberButton}" 
                                    Padding="6,2" FontSize="11" Click="OnClearSearchClick" Visibility="Collapsed"/>
                        </Grid>
                    </Border>

                    <!-- Paragraphs Scrollable Container -->
                    <ScrollViewer x:Name="ScrollerFullScript" Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,0,0,8">
                        <ItemsControl x:Name="ItemsFullScript">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,10" Background="#21262D" BorderBrush="#30363D" BorderThickness="1" 
                                            CornerRadius="6" Padding="14,12">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Paragraph Header -->
                                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                    <Border Background="#1F6FEB" CornerRadius="4" Padding="6,2">
                                                        <TextBlock Text="{Binding StoryNumber, StringFormat='Scene #{0}'}" 
                                                                   FontWeight="Bold" FontSize="12" Foreground="White"/>
                                                    </Border>
                                                </StackPanel>

                                                <!-- Jump Button -->
                                                <Button Grid.Column="1" Content="Navigate Here ➔" Style="{StaticResource CyberButton}" 
                                                        Padding="8,3" FontSize="11" Click="OnJumpToNodeClick" Tag="{Binding}"/>
                                            </Grid>

                                            <!-- Story Paragraph Content -->
                                            <TextBlock Grid.Row="1" Text="{Binding StoryText}" TextWrapping="Wrap" 
                                                       FontSize="13.5" LineHeight="20" Foreground="#F0F6FC"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Stats Footer -->
                    <Border Grid.Row="3" Background="#21262D" CornerRadius="6" Padding="10,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="TxtFullScriptStats" Grid.Column="0" Text="12 paragraphs | 275 words" 
                                       FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                            <TextBlock Grid.Column="1" Text="Story Flow: Ordered Sequentially" FontSize="12" Foreground="{StaticResource AccentGreen}"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- GridSplitter for responsive resizing in Split View -->
            <GridSplitter x:Name="MainSplitter" Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent" Cursor="SizeWE"/>

            <!-- ======================================================== -->
            <!-- DISPLAY AREA 2: ONE LINE AT A TIME DISPLAY               -->
            <!-- ======================================================== -->
            <Border x:Name="CardDisplayArea2" Grid.Column="2" Background="#161B22" BorderBrush="#30363D" 
                    BorderThickness="1" CornerRadius="8" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Top Sub-Header -->
                        <RowDefinition Height="Auto"/>
                        <!-- Progress Bar & Indicator -->
                        <RowDefinition Height="Auto"/>
                        <!-- Main Card -->
                        <RowDefinition Height="*"/>
                        <!-- Pointer Info Bar -->
                        <RowDefinition Height="Auto"/>
                        <!-- Navigation Buttons -->
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🎮 DISPLAY AREA 2: ONE-LINE READER" FontSize="15" FontWeight="Bold" Foreground="{StaticResource AccentCyanGlow}"/>
                        <TextBlock x:Name="TxtIndexIndicator" Grid.Column="1" Text="SCENE 1 OF 12" FontSize="13" FontWeight="Bold" Foreground="{StaticResource AccentOrange}"/>
                    </Grid>

                    <!-- Visual Story Progress Slider -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,14">
                        <ProgressBar x:Name="StoryProgressBar" Height="6" Minimum="1" Maximum="12" Value="1" 
                                     Background="#21262D" Foreground="{StaticResource AccentCyanGlow}" BorderThickness="0"/>
                    </StackPanel>

                    <!-- Hero Story Card -->
                    <Border Grid.Row="2" Background="#21262D" BorderBrush="#30363D" BorderThickness="1.5" CornerRadius="8" Padding="20">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel VerticalAlignment="Center">
                                <!-- Chapter Badge -->
                                <Border HorizontalAlignment="Left" Background="#1F6FEB" CornerRadius="4" Padding="10,4" Margin="0,0,0,16">
                                    <TextBlock x:Name="TxtCardChapterBadge" Text="CHAPTER 1" FontWeight="Black" FontSize="13" Foreground="White"/>
                                </Border>

                                <!-- Large Story Line -->
                                <TextBlock x:Name="TxtSingleLineStory" 
                                           Text="In the virtual realm of Cybersphere, our hero, Alex, a determined IT student, embarks on an epic quest for knowledge." 
                                           TextWrapping="Wrap" FontSize="17" LineHeight="26" FontWeight="Normal" 
                                           Foreground="#F0F6FC" Margin="0,0,0,20"/>

                                <!-- Quotation Decorator -->
                                <TextBlock Text="— Cybersphere Chronicles" FontStyle="Italic" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- Linked List Node Pointer Inspector -->
                    <Border Grid.Row="3" Background="#0D1117" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Margin="0,12,0,12" Padding="10,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="TxtPrevPointer" Grid.Column="0" Text="◀ Prev: [None - Head]" FontSize="11" 
                                       Foreground="{StaticResource TextSecondary}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="TxtCurrentPointer" Grid.Column="1" Text="● Active: [1]" FontSize="12" 
                                       FontWeight="Bold" Foreground="{StaticResource AccentCyan}"/>
                            <TextBlock x:Name="TxtNextPointer" Grid.Column="2" Text="Next: [2] ▶" FontSize="11" 
                                       Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </Border>

                    <!-- Navigation Action Controls -->
                    <Grid Grid.Row="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Primary Next & Previous Buttons -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button x:Name="BtnPrevious" Grid.Column="0" Content="◀  Previous" Style="{StaticResource NavButton}" 
                                    Click="OnPreviousClick" Margin="0,0,6,0" ToolTip="Go to previous paragraph (Left Arrow)"/>
                            <Button x:Name="BtnNext" Grid.Column="1" Content="Next  ▶" Style="{StaticResource NavButton}" 
                                    Click="OnNextClick" Margin="6,0,0,0" ToolTip="Go to next paragraph (Right Arrow)"/>
                        </Grid>

                        <!-- Secondary Controls: First, Last, Auto-Play -->
                        <Grid Grid.Row="1" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button Content="⏮ First" Style="{StaticResource CyberButton}" Click="OnFirstClick" 
                                    Grid.Column="0" Padding="10,6" FontSize="12" ToolTip="Jump to Head node (Home)"/>

                            <!-- Auto-Play Button -->
                            <Button x:Name="BtnAutoPlay" Content="▶️ Auto-Tour (Story Slide)" Style="{StaticResource CyberButton}" 
                                    Click="OnAutoPlayClick" Grid.Column="1" Margin="8,0" Padding="10,6" FontSize="12" 
                                    ToolTip="Automatically step through paragraphs"/>

                            <Button Content="Last ⏭" Style="{StaticResource CyberButton}" Click="OnLastClick" 
                                    Grid.Column="2" Padding="10,6" FontSize="12" ToolTip="Jump to Tail node (End)"/>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ========================================== -->
        <!-- ROW 4: BOTTOM LINKED LIST NODE VISUALIZER -->
        <!-- ========================================== -->
        <Border Grid.Row="4" Background="#161B22" BorderBrush="#30363D" BorderThickness="0,1,0,0" Padding="20,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="🔗 LIVE LINKED LIST DATA STRUCTURE CHAIN" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentCyan}"/>
                    <TextBlock x:Name="TxtListPointersSummary" Grid.Column="1" Text="Head: [1] | Tail: [12] | Nodes: 12" 
                               FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                </Grid>

                <!-- Scrollable horizontal chain of linked list nodes -->
                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="ItemsNodeChain">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="{Binding BgColor}" BorderBrush="{Binding BorderColor}" 
                                            BorderThickness="1" CornerRadius="4" Padding="8,4" Cursor="Hand"
                                            MouseLeftButtonUp="OnVisualNodeClick" Tag="{Binding Node}">
                                        <TextBlock Text="{Binding Node.StoryNumber, StringFormat='[{0}]'}" 
                                                   FontWeight="Bold" FontSize="12" Foreground="{Binding TextColor}"/>
                                    </Border>
                                    <TextBlock Text=" ➔ " Foreground="#6E7681" FontSize="11" VerticalAlignment="Center" 
                                               Visibility="{Binding ArrowVisibility}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ========================================== -->
        <!-- ROW 5: STATUS BAR -->
        <!-- ========================================== -->
        <Border Grid.Row="5" Background="#0D1117" BorderBrush="#30363D" BorderThickness="0,1,0,0" Padding="20,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="TxtStatusMessage" Grid.Column="0" Text="Ready | Linked list initialized with sample script data." 
                           FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                <TextBlock x:Name="TxtMetrics" Grid.Column="1" Text="Sort Time: 0.00ms | Operations: 0" 
                           FontSize="12" Foreground="{StaticResource AccentGreen}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
